# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend Configuration
# For production: https://your-backend-domain.com or leave empty to use same origin
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ENABLE_EVENT_REGISTRATION=yes

# External Registration URL (optional - if set, redirects to third-party form instead of internal registration)
# Example: https://forms.google.com/your-form-id or https://tally.so/r/your-form-id
NEXT_PUBLIC_EXTERNAL_REGISTRATION_URL=

# Event-Only Mode - Set to event slug to show only that event page (e.g., "over-square-2025")
# Leave empty or comment out to show full website
NEXT_PUBLIC_EVENT_ONLY_MODE=

# Convex Configuration
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# ImageKit Configuration
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Admin Secret (generate with: openssl rand -hex 32)
ADMIN_SECRET=your_secure_admin_secret_here
