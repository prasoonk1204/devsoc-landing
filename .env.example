# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend Configuration
# For development: http://localhost:3001
# For production: https://your-backend-domain.com or leave empty to use same origin
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENABLE_EVENT_REGISTRATION=yes

# Convex Configuration
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# ImageKit Configuration
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Admin Secret (generate with: openssl rand -hex 32)
ADMIN_SECRET=your_secure_admin_secret_here
