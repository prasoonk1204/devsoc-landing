APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27018/
MONGODB_DB=devsoc

# Generate with npm run admin:hash, supplying password through stdin.
# The password must contain at least 16 characters.
ADMIN_PASSWORD_HASH=

# Server-only ImageKit configuration
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_account

# Existing external feedback service
FEEDBACK_API_URL=
FEEDBACK_API_KEY=
