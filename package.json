{
	"name": "devsoc-landing",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"dev:server": "cd server && bun --watch index.ts",
		"build": "next build",
		"build:frontend": "next build",
		"build:server": "cd server && npm run build",
		"build:all": "npm run build:frontend && npm run build:server",
		"start": "npm run start:server & next start -p ${PORT:-3000}",
		"start:server": "cd server && PORT=${BACKEND_PORT:-3001} bun index.ts",
		"start:production": "npm run start",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write . --cache",
		"format:check": "prettier --check . --cache",
		"convex:dev": "convex dev",
		"convex:deploy": "convex deploy"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.0",
		"@react-three/drei": "10.7.7",
		"@react-three/fiber": "9.4.2",
		"@vercel/analytics": "^1.5.0",
		"axios": "^1.13.2",
		"clsx": "^2.1.1",
		"convex": "^1.29.1",
		"dotenv": "^17.2.3",
		"elysia": "^1.4.16",
		"imagekit": "^6.0.0",
		"lenis": "^1.3.14",
		"lucide-react": "^0.552.0",
		"motion": "^12.23.24",
		"next": "16.0.1",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-intersection-observer": "^10.0.0",
		"tailwind-merge": "^3.4.0",
		"three": "0.181.0",
		"three-stdlib": "^2.36.1",
		"winston": "^3.18.3",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "24.10.1",
		"baseline-browser-mapping": "^2.8.32",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"tailwindcss": "^4",
		"typescript": "5.9.3"
	}
}
